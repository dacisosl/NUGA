<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 바탕: 밤 유리. 96% 불투명이라 어떤 배경화면 위에서도 글자 대비가 같다 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F5102136" android:endColor="#F5081422" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- 오른쪽 위 푸른 번짐 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.92"
                android:centerY="0"
                android:gradientRadius="220dp"
                android:startColor="#475495FD"
                android:centerColor="#145495FD"
                android:endColor="#005495FD" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- 테두리: 옅은 하늘빛 선 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#38ABC9F1" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- 위 테두리 빛줄기: 오른쪽이 밝다 -->
    <item android:gravity="top" android:height="1dp" android:left="24dp" android:right="18dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:centerX="0.75" android:startColor="#00EAF2FF" android:centerColor="#73EAF2FF" android:endColor="#00EAF2FF" />
        </shape>
    </item>
</layer-list>
